{
  "name": "keyboard-shapes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Physical analysis of mechanical keyboards: shape, 3D, compatibility.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-data/index.ts",
    "generate": "tsx scripts/generate-reference-data/index.ts && tsx scripts/generate-2d/index.ts",
    "generate:models": "tsx scripts/generate-3d/index.ts",
    "optimize": "tsx scripts/optimize-models/index.ts",
    "import": "tsx scripts/import-product/index.ts",
    "lookup": "tsx scripts/lookup/index.ts",
    "extract:metadata": "tsx scripts/extract-metadata/index.ts",
    "extract:images": "tsx scripts/extract-images/index.ts",
    "detect:layout": "tsx scripts/detect-layout/index.ts",
    "reconstruct:shape": "tsx scripts/reconstruct-shape/index.ts",
    "keyboard:add": "tsx scripts/add-entity/index.ts keyboard",
    "component:add": "tsx scripts/add-entity/index.ts component"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "draco3dgltf": "^1.5.7",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
